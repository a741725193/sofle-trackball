#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include "sofle_trackball.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        /delete-property/ zmk,underglow;
        /delete-property/ zmk,backlight;
    };

    mock_kscan: kscan_mock_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;
        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        input-processors = <&mouse_runtime_input_processor>;
    };
};

&kscan0 {
    status = "disabled";
};

/* spi3's pinctrl (spi3_default/spi3_sleep, required by the eyelash_nano
 * board regardless of shield) is supplied by the prospector_adapter
 * shield's own boards/eyelash_nano.overlay, which repurposes spi3 to
 * drive the Prospector's ST7789V display. */

/* TEMP DIAGNOSTIC: disable the ST7789/SPI3 display bus to check whether
 * its (unverified) pin mapping is what's hanging boot. Requires
 * build.yaml's shield order to list prospector_adapter BEFORE
 * sofle_trackball_dongle so this override applies last. Revert once
 * the display init is confirmed (or not) as the cause. */
&spi3 {
    status = "disabled";
};

&{/mipi_dbi} {
    status = "disabled";
};
