#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include "sofle_trackball.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        /delete-property/ zmk,underglow;
        /delete-property/ zmk,backlight;
    };

    mock_kscan: kscan_mock_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;
        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        input-processors = <&mouse_runtime_input_processor>;
    };
};

&kscan0 {
    status = "disabled";
};

/* TEMP DIAGNOSTIC: P0.10 (the Prospector backlight PWM pin) is the
 * nRF52840's NFC2 antenna pin by default, and nothing in this repo has
 * ever used it as a plain GPIO/PWM pin before (unlike P0.10 on the
 * eyelash_nano board's own spi1_default, which never actually applies
 * since spi1 stays disabled here). Explicitly route NFC pins to GPIO. */
&uicr {
    nfct-pins-as-gpios;
};
