#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include "sofle_trackball.dtsi"

/ {
    chosen {
        zmk,kscan = &mock_kscan;
        /delete-property/ zmk,underglow;
        /delete-property/ zmk,backlight;
    };

    mock_kscan: kscan_mock_0 {
        compatible = "zmk,kscan-mock";
        columns = <0>;
        rows = <0>;
        events = <0>;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;
        trackball_split: trackball_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball_split>;
        input-processors = <&mouse_runtime_input_processor>;
    };
};

&kscan0 {
    status = "disabled";
};

/* The eyelash_nano board unconditionally wires spi3's pinctrl to these
 * labels for the underglow LED strip. The dongle has no LED strip, but
 * the labels must still resolve, so point them at an unused pin. */
&pinctrl {
    spi3_default: spi3_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
        };
    };
    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 11)>;
            low-power-enable;
        };
    };
};
